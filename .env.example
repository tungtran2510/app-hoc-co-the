# Supabase API (Lấy từ Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Chỉ dùng phía server, không lộ ra client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mật khẩu quản trị viên (Admin)
ADMIN_PASSWORD=your_secure_admin_password_here

# Chuỗi bí mật ký HMAC cookie xác thực Admin (chuỗi ngẫu nhiên dài)
ADMIN_SECRET=your_long_random_admin_secret_string_here
